# Control Plane Configuration
APP_NAME="HR Professional Services Business Suite"
APP_ENV="development"
PORT=8000
HOST="127.0.0.1"
DEBUG=true

# Security & Sessions
JWT_SECRET="generate-a-strong-secret-key-for-production"
JWT_ALGORITHM="HS256"
SESSION_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite for local development, PostgreSQL for production)
DATABASE_URL="sqlite:///./business_suite.db"

# Google OAuth (Optional / Production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# Connected Service Gateways
CRM_URL="http://127.0.0.1:8002"
ACCOUNTS_URL="http://127.0.0.1:8003"
HRMS_URL="http://127.0.0.1:8004"
ERP_URL="http://127.0.0.1:8005"
HELPDESK_URL="http://127.0.0.1:8006"
BOOKING_URL="http://127.0.0.1:8007"
CLIENT_PORTAL_URL="http://127.0.0.1:8009"
